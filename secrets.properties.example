# Copy to secrets.properties (untracked) and fill in.
# A YouTube Data API v3 key, restricted to the YouTube Data API. Optional: without it the YouTube tile shows only the
# rows the TV already publishes, and nothing if the TV does not let the launcher read them.
YOUTUBE_API_KEY=
# ISO 3166-1 alpha-2 country code for YouTube's "most popular" chart (default US).
REGION_CODE=US
